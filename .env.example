# Copy to .env at the repository root (gitignored). The backend reads .env here first, then
# backend/core/.env; an empty value counts as unset. Never commit real keys.

# ---- Application -------------------------------------------------------------------------
APP_ENVIRONMENT=development            # development | test | production (production hides /docs)
APP_DEBUG=false
APP_API_PREFIX=/api/v1
APP_PUBLIC_BASE_URL=http://localhost:8000   # used to build media URLs returned by the API
APP_CORS_ORIGINS=http://localhost:3000
# Requests at or above this are logged at INFO with their timing; the rest at DEBUG.
APP_SLOW_REQUEST_MS=500
APP_FRONTEND_URL=http://localhost:3000

# ---- Database ----------------------------------------------------------------------------
# Local Postgres for development. On Supabase use the transaction pooler (6543) at runtime
# and the direct connection (5432) for Alembic.
DATABASE_URL=postgresql://localhost:5432/cdtm_community
DATABASE_MIGRATOR_URL=
DATABASE_POOL_SIZE=5
DATABASE_STATEMENT_TIMEOUT_MS=15000
# Transaction pooling is detected from the port (6543). Set this only when something in
# front of the pooler hides it: it turns off asyncpg's prepared statements and re-arms
# statement_timeout inside every transaction.
DATABASE_POOLER_TRANSACTION_MODE=false

# ---- Supabase (Auth + private Storage). Leave empty until the project exists. -------------
SUPABASE_URL=
# Legacy HS256 signing secret. Once the project uses asymmetric signing keys, leave this
# unset in production (an empty value counts as unset): SUPABASE_URL is enough, the verifier
# fetches the JWKS, and a shared symmetric secret is a second way to mint a token this API
# accepts. Keep it only where AUTH_DEV_LOGIN_ENABLED=true, which signs with it.
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=             # server only, never NEXT_PUBLIC_

# ---- Auth --------------------------------------------------------------------------------
AUTH_ALLOWED_EMAIL_DOMAINS=cdtm.com
AUTH_ADMIN_EMAILS=                     # comma list, bootstraps admins on first sign-in
AUTH_JWT_AUDIENCE=authenticated
# How stale accounts.last_sign_in_at may get before a request refreshes it. Every
# authenticated request used to write that column, which made every GET a row write.
AUTH_SIGN_IN_TOUCH_SECONDS=900
# Local only: mints HS256 tokens with SUPABASE_JWT_SECRET so you can sign in without Google.
# The app refuses to start with this on in production.
AUTH_DEV_LOGIN_ENABLED=true
# Any 32+ byte string works locally when dev login is on (it is the HS256 signing key).
# SUPABASE_JWT_SECRET=local-dev-secret-change-me-please-32-bytes

# ---- Storage (uploads go through the API; buckets are private) ---------------------------
STORAGE_BACKEND=local                  # local | supabase
STORAGE_LOCAL_DIR=.data/media
STORAGE_MAX_UPLOAD_BYTES=5242880

# ---- Natural-language Ask (Paths, Jobs, Housing) -----------------------------------------
# none = rule-based translator only (works offline). openai = OpenAI-compatible API.
LLM_PROVIDER=openai
LLM_API_KEY=                           # sk-... (OpenAI). Keep it here, never in the frontend.
LLM_MODEL=gpt-5.6-luna
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_S=20
LLM_MAX_QUESTIONS_PER_MINUTE=20

# ---- Frontend (frontend/.env.local, see frontend/README.md) ------------------------------
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_AUTH_MODE=dev            # dev | supabase
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
